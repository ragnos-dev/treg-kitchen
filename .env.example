KITCHEN_MODEL_PROVIDER=openai
KITCHEN_OPENAI_API_KEY=
KITCHEN_OPENAI_ORG_ID=
KITCHEN_OPENAI_PROJECT_ID=

# Connect a dedicated private Vercel Blob store, then initialize the ledger once.
KITCHEN_BUDGET_STORE=blob
BLOB_READ_WRITE_TOKEN=
# For a Redis deployment, set KITCHEN_BUDGET_STORE=redis.
KITCHEN_REDIS_URL=
KITCHEN_REDIS_TOKEN=

# Optional Gateway provider mode uses verified included credits plus project OIDC or a scoped key.
KITCHEN_FREE_CREDITS_VERIFIED=0
AI_GATEWAY_API_KEY=
